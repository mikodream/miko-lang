// vec<T>: growable arrays with reference semantics.
struct Point {
    x: i32,
    y: i32,
}

struct Path {
    name: string,
    points: vec<Point>,
}

fn sum(values: vec<i32>): i64 {
    let total: i64 = 0;
    let count = len(values);
    let i: i64 = 0;
    while i < count {
        total = total + values[i];
        i = i + 1;
    }
    return total;
}

fn make_counter(): vec<i32> {
    let v: vec<i32> = vec_new();
    vec_push(v, 1);
    vec_push(v, 2);
    vec_push(v, 3);
    return v;
}

fn main() {
    let v: vec<i32> = vec_new();
    print(len(v));
    vec_push(v, 10);
    vec_push(v, 20);
    vec_push(v, 30);
    print(len(v));
    print(v[0] + v[1] + v[2]);
    v[1] = 99;
    print(v[1]);
    print(sum(v));

    vec_pop(v);
    print(len(v));
    print(v[len(v) - 1]);

    vec_reserve(v, 64);
    vec_clear(v);
    print(len(v));

    let shared = v;
    vec_push(shared, 7);
    print(len(v));

    let path = Path { name: "route", points: vec_new() };
    vec_push(path.points, Point { x: 1, y: 2 });
    vec_push(path.points, Point { x: 3, y: 4 });
    print(path.name);
    print(path.points[0].x + path.points[1].y);
}
