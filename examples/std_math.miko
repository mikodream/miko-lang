// stdlib/core/math: i64 / f64 helpers.
import core.math as math;

fn main() {
    print(math.max_i64(10, 7));
    print(math.min_i64(10, 7));
    print(math.abs_i64(-9));
    print(math.clamp_i64(15, 0, 10));
    print(math.gcd_i64(48, 18));
    print(math.lcm_i64(4, 6));
    print(math.pow_i64(2, 10));
    print(math.is_even_i64(4));

    print(math.abs_f64(-2.5));
    print(math.max_f64(1.5, 2.5));
    print(math.min_f64(1.5, 2.5));
    print(sqrt_f64(16.0));
    print(floor_f64(2.9));
    print(ceil_f64(2.1));
    print(round_f64(2.5));
    print(f64_to_i64(7.9));
}
