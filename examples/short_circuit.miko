// Short-circuit evaluation and multiline string literals.
//
// Both are load-bearing for the compiler itself: the guard pattern below is
// what keeps `char_at` from reading past the end of a string while scanning,
// and multiline literals are how compiler modules embed their lists.
//
// Expected output: 4 4 18 4
//
//   find_space -> 4     'a'..'e' then a space, found at index 4
//   count_spaces -> 4   four spaces in "a b c d e"
//   len(list) -> 18     three newlines plus the trailing one
//   count_lines -> 4    four lines
//
// If `&&` were compiled without short-circuiting, the first call would read
// text[4] of a 4-character string and abort instead of returning.
fn find_space(text: string): i64 {
    let n = len(text);
    let i = 0;
    // The left side of && bounds the index used by the right side.
    while i < n && char_at(text, i) != ' ' {
        i = i + 1;
    }
    return i;
}

fn count_spaces(text: string): i64 {
    let n = len(text);
    let i = 0;
    let count = 0;
    while i < n {
        if char_at(text, i) == ' ' {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn count_lines(text: string): i64 {
    let n = len(text);
    let i = 0;
    let count = 1;
    while i < n {
        if char_at(text, i) == '\n' {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn main() {
    // "abcd" has no space: the loop must stop at i == n, not run past it.
    print(find_space("abcd"));
    print(count_spaces("a b c d e"));

    let list = "token
ast
symbols
";
    print(len(list));
    print(count_lines(list));
}
