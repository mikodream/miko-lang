fn main() {
    print(arg_count());
    if arg_count() >= 2 {
        print(arg_at(0) + ":" + arg_at(1));
    }

    let text = "abcdef";
    print(len(text));
    print(char_at(text, 2));
    print(substring(text, 1, 3));

    write_file("out/stage0_builtins.txt", "file-ok");
    print(read_file("out/stage0_builtins.txt"));
}
