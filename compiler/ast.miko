pub fn line0(text: string): string {
    return text + "\n";
}

pub fn line1(text: string): string {
    return "  " + text + "\n";
}

pub fn line2(text: string): string {
    return "    " + text + "\n";
}

pub fn line3(text: string): string {
    return "      " + text + "\n";
}

pub fn line4(text: string): string {
    return "        " + text + "\n";
}

// ---- source positions ------------------------------------------------------
//
// The parser appends " @<line>" to the nodes a diagnostic can point at, so the
// line travels with the tree instead of being re-derived from token ordinals
// later. Every reader of the tree goes through strip_pos, so the nodes a backend
// sees are byte-identical to what they were before positions existed - that is
// what keeps the emitted IR unchanged.

fn is_digit_char(ch: char): bool {
    return ch >= '0' && ch <= '9';
}

// The line the node was parsed from, or 0 when it carries no position.
pub fn line_pos(text: string): i64 {
    let n = len(text);
    if n < 3 || char_at(text, n - 1) < '0' || char_at(text, n - 1) > '9' {
        return 0;
    }
    let i = n - 1;
    while i >= 0 && is_digit_char(char_at(text, i)) {
        i = i - 1;
    }
    if i < 1 || char_at(text, i) != '@' {
        return 0;
    }
    if i < 2 || char_at(text, i - 1) != ' ' {
        return 0;
    }
    let value = 0;
    let j = i + 1;
    while j < n {
        value = value * 10 + (char_at(text, j) - '0');
        j = j + 1;
    }
    return value;
}

// The node text without its position suffix.
pub fn strip_pos(text: string): string {
    let n = len(text);
    if n < 3 || char_at(text, n - 1) < '0' || char_at(text, n - 1) > '9' {
        return text;
    }
    let i = n - 1;
    while i >= 0 && is_digit_char(char_at(text, i)) {
        i = i - 1;
    }
    if i < 1 || char_at(text, i) != '@' {
        return text;
    }
    if i < 2 || char_at(text, i - 1) != ' ' {
        return text;
    }
    return substring(text, 0, i - 1);
}