import "token.miko" as token;

fn is_space(ch: char): bool {
    return ch <= ' ';
}

fn is_digit(ch: char): bool {
    return ch >= '0' && ch <= '9';
}

fn is_hex_digit(ch: char): bool {
    if is_digit(ch) {
        return true;
    }
    if ch >= 'a' {
        if ch <= 'f' {
            return true;
        }
    }
    if ch >= 'A' {
        if ch <= 'F' {
            return true;
        }
    }
    return false;
}

fn is_radix_marker(ch: char): bool {
    return ch == 'x' || ch == 'X' || ch == 'b' || ch == 'B' || ch == 'o' || ch == 'O';
}

fn is_radix_digit(ch: char, hex: bool): bool {
    if ch == '_' {
        return true;
    }
    if hex {
        return is_hex_digit(ch);
    }
    return is_digit(ch);
}

fn is_digit_or_separator(ch: char): bool {
    return is_digit(ch) || ch == '_';
}

fn contains_char(text: string, target: char): bool {
    let n = len(text);
    let i: i64 = 0;
    while i < n {
        if char_at(text, i) == target {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn is_alpha(ch: char): bool {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_';
}

fn is_alnum(ch: char): bool {
    return is_alpha(ch) || is_digit(ch);
}

fn keyword_kind(text: string): string {
    if text == "fn" {
        return "KwFn";
    }
    if text == "let" {
        return "KwLet";
    }
    if text == "return" {
        return "KwReturn";
    }
    if text == "if" {
        return "KwIf";
    }
    if text == "else" {
        return "KwElse";
    }
    if text == "while" {
        return "KwWhile";
    }
    if text == "for" {
        return "KwFor";
    }
    if text == "break" {
        return "KwBreak";
    }
    if text == "continue" {
        return "KwContinue";
    }
    if text == "true" {
        return "KwTrue";
    }
    if text == "false" {
        return "KwFalse";
    }
    if text == "const" {
        return "KwConst";
    }
    if text == "pub" {
        return "KwPub";
    }
    if text == "as" {
        return "KwAs";
    }
    if text == "extern" {
        return "KwExtern";
    }
    if text == "import" {
        return "KwImport";
    }
    if text == "struct" {
        return "KwStruct";
    }
    if text == "enum" {
        return "KwEnum";
    }
    return "Identifier";
}

pub fn lex(source: string): string {
    let length = len(source);
    let i = 0;
    let stream = "";

    while i < length {
        let ch = char_at(source, i);

        if is_space(ch) {
            i = i + 1;
            continue;
        }

        if is_alpha(ch) {
            let start = i;
            i = i + 1;
            while i < length && is_alnum(char_at(source, i)) {
                i = i + 1;
            }
            let text = substring(source, start, i - start);
            stream = token.append_token(stream, keyword_kind(text), text);
            continue;
        }

        if is_digit(ch) {
            let start = i;
            i = i + 1;
            // 0x / 0b / 0o radix prefixes. Always integers, so no fractional
            // part is looked for, and '_' separators are part of the literal.
            if ch == '0' {
                if i < length && is_radix_marker(char_at(source, i)) {
                    let hex = char_at(source, i) == 'x' || char_at(source, i) == 'X';
                    i = i + 1;
                    while i < length && is_radix_digit(char_at(source, i), hex) {
                        i = i + 1;
                    }
                    stream = token.append_token(stream, "IntegerLiteral", substring(source, start, i - start));
                    continue;
                }
            }
            while i < length && is_digit_or_separator(char_at(source, i)) {
                i = i + 1;
            }
            if i < length && char_at(source, i) == '.' {
                if i + 1 < length && is_digit(char_at(source, i + 1)) {
                    i = i + 1;
                    while i < length && is_digit_or_separator(char_at(source, i)) {
                        i = i + 1;
                    }
                }
            }
            // Exponent, only when a digit really follows the marker.
            if i < length && (char_at(source, i) == 'e' || char_at(source, i) == 'E') {
                let probe = i + 1;
                if probe < length && (char_at(source, probe) == '+' || char_at(source, probe) == '-') {
                    probe = probe + 1;
                }
                if probe < length && is_digit(char_at(source, probe)) {
                    i = probe;
                    while i < length && is_digit_or_separator(char_at(source, i)) {
                        i = i + 1;
                    }
                    stream = token.append_token(stream, "FloatLiteral", substring(source, start, i - start));
                    continue;
                }
            }
            let text = substring(source, start, i - start);
            if contains_char(text, '.') {
                stream = token.append_token(stream, "FloatLiteral", text);
            } else {
                stream = token.append_token(stream, "IntegerLiteral", text);
            }
            continue;
        }

        if ch == '"' {
            let start = i;
            i = i + 1;
            while i < length && char_at(source, i) != '"' {
                if char_at(source, i) == '\\' {
                    i = i + 1;
                }
                i = i + 1;
            }
            if i < length {
                i = i + 1;
            }
            stream = token.append_token(stream, "StringLiteral", substring(source, start, i - start));
            continue;
        }

        if ch == '\'' {
            let start = i;
            i = i + 1;
            if i < length && char_at(source, i) == '\\' {
                i = i + 1;
            }
            if i < length {
                i = i + 1;
            }
            if i < length && char_at(source, i) == '\'' {
                i = i + 1;
            }
            stream = token.append_token(stream, "CharLiteral", substring(source, start, i - start));
            continue;
        }

        if ch == '/' && i + 1 < length && char_at(source, i + 1) == '/' {
            i = i + 2;
            while i < length && char_at(source, i) != '\n' {
                i = i + 1;
            }
            continue;
        }

        if ch == '=' && i + 1 < length && char_at(source, i + 1) == '=' {
            stream = token.append_token(stream, "EqualEqual", "==");
            i = i + 2;
            continue;
        }
        if ch == '!' && i + 1 < length && char_at(source, i + 1) == '=' {
            stream = token.append_token(stream, "BangEqual", "!=");
            i = i + 2;
            continue;
        }
        if ch == '<' && i + 1 < length && char_at(source, i + 1) == '=' {
            stream = token.append_token(stream, "LessEqual", "<=");
            i = i + 2;
            continue;
        }
        if ch == '>' && i + 1 < length && char_at(source, i + 1) == '=' {
            stream = token.append_token(stream, "GreaterEqual", ">=");
            i = i + 2;
            continue;
        }
        if ch == '&' && i + 1 < length && char_at(source, i + 1) == '&' {
            stream = token.append_token(stream, "AndAnd", "&&");
            i = i + 2;
            continue;
        }
        if ch == '|' && i + 1 < length && char_at(source, i + 1) == '|' {
            stream = token.append_token(stream, "OrOr", "||");
            i = i + 2;
            continue;
        }
        if ch == '-' && i + 1 < length && char_at(source, i + 1) == '>' {
            stream = token.append_token(stream, "Arrow", "->");
            i = i + 2;
            continue;
        }

        if ch == '+' {
            stream = token.append_token(stream, "Plus", "+");
            i = i + 1;
            continue;
        }
        if ch == '-' {
            stream = token.append_token(stream, "Minus", "-");
            i = i + 1;
            continue;
        }
        if ch == '*' {
            stream = token.append_token(stream, "Star", "*");
            i = i + 1;
            continue;
        }
        if ch == '/' {
            stream = token.append_token(stream, "Slash", "/");
            i = i + 1;
            continue;
        }
        if ch == '%' {
            stream = token.append_token(stream, "Percent", "%");
            i = i + 1;
            continue;
        }
        if ch == '=' {
            stream = token.append_token(stream, "Equal", "=");
            i = i + 1;
            continue;
        }
        if ch == '!' {
            stream = token.append_token(stream, "Bang", "!");
            i = i + 1;
            continue;
        }
        if ch == '<' {
            stream = token.append_token(stream, "Less", "<");
            i = i + 1;
            continue;
        }
        if ch == '>' {
            stream = token.append_token(stream, "Greater", ">");
            i = i + 1;
            continue;
        }
        if ch == '(' {
            stream = token.append_token(stream, "LeftParen", "(");
            i = i + 1;
            continue;
        }
        if ch == ')' {
            stream = token.append_token(stream, "RightParen", ")");
            i = i + 1;
            continue;
        }
        if ch == '{' {
            stream = token.append_token(stream, "LeftBrace", "{");
            i = i + 1;
            continue;
        }
        if ch == '}' {
            stream = token.append_token(stream, "RightBrace", "}");
            i = i + 1;
            continue;
        }
        if ch == '[' {
            stream = token.append_token(stream, "LeftBracket", "[");
            i = i + 1;
            continue;
        }
        if ch == ']' {
            stream = token.append_token(stream, "RightBracket", "]");
            i = i + 1;
            continue;
        }
        if ch == ',' {
            stream = token.append_token(stream, "Comma", ",");
            i = i + 1;
            continue;
        }
        if ch == '.' {
            stream = token.append_token(stream, "Dot", ".");
            i = i + 1;
            continue;
        }
        if ch == ':' && i + 1 < length && char_at(source, i + 1) == ':' {
            stream = token.append_token(stream, "DoubleColon", "::");
            i = i + 2;
            continue;
        }
        if ch == ':' {
            stream = token.append_token(stream, "Colon", ":");
            i = i + 1;
            continue;
        }
        if ch == ';' {
            stream = token.append_token(stream, "Semicolon", ";");
            i = i + 1;
            continue;
        }

        stream = token.append_char_token(stream, "Invalid", ch);
        i = i + 1;
    }

    return token.append_token(stream, "EndOfFile", "");
}

