import "ast.miko" as ast;
// main_ll.miko - driver for the self-hosted miko->LLVM IR compiler.
//
// Pipeline: read every module -> lex -> parse -> concatenate into ONE program
// tree -> sema -> codegen_ll -> write a single .ll
//
// Compiling the whole program as one LLVM module (rather than one module per
// source file) is what lets the IR backend resolve every call by signature:
// the generator sees all definitions at once, so cross-module calls need no
// external declarations and no guessing of return types. Definitions are
// disambiguated by module-name mangling (see codegen_ll.mangle_pair), because
// modules legitimately reuse private helper names such as `find_char`.
//
// Self-hosting chain (cmake/BootstrapLLVM.cmake):
//
//   stage0 (C++ miko) interprets this driver, emitting one .ll for the whole
//   compiler; clang turns that .ll plus runtime/miko_runtime.c into an
//   executable                                                -> stage1_ll
//   stage1_ll emits the same .ll again                        -> stage2_ll.ll
//   stage2_ll emits it once more                              -> stage3_ll.ll
//
// stage2_ll.ll == stage3_ll.ll byte for byte is the fixed point: the compiler
// written in miko, compiled through LLVM IR, reproduces its own IR exactly.
import "lexer.miko" as lexer;
import "parser.miko" as parser;
import "sema.miko" as sema;
import "codegen_ll.miko" as codegen_ll;

// The modules that make up the compiler itself, in dependency order.
// A comma-separated module list from the command line lets a subset of the
// compiler be built in isolation while debugging. Flags (anything starting with
// `--`) are not module lists, so they fall through to the full list - without
// that check `miko --self out/x` would try to read `compiler/--self.miko`.
fn module_list(): string {
    if arg_count() >= 1 {
        let given = arg_at(0);
        let is_flag = false;
        if len(given) >= 2 {
            if char_at(given, 0) == '-' {
                if char_at(given, 1) == '-' {
                    is_flag = true;
                }
            }
        }
        if !is_flag {
            let out = "";
            let i: i64 = 0;
            let n = len(given);
            while i < n {
                let ch = char_at(given, i);
                if ch == ',' {
                    out = out + "\n";
                } else {
                    out = out + substring(given, i, 1);
                }
                i = i + 1;
            }
            return out + "\n";
        }
    }
    return "token\nast\nsymbols\ntype\nlexer\nparser\nsema\ncodegen_ll\nmain_ll\n";
}

fn module_at(list: string, index: i64): string {
    let i: i64 = 0;
    let k: i64 = 0;
    let n = len(list);
    while i < n {
        let line_end = i;
        while line_end < n && char_at(list, line_end) != '\n' {
            line_end = line_end + 1;
        }
        if k == index {
            return substring(list, i, line_end - i);
        }
        k = k + 1;
        i = line_end + 1;
    }
    return "";
}

fn module_count(list: string): i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    let n = len(list);
    while i < n {
        if char_at(list, i) == '\n' {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn combine_modules(): string {
    let list = module_list();
    let out = "";
    let k: i64 = 0;
    while k < module_count(list) {
        let name = module_at(list, k);
        if name != "" {
            let source = read_file("compiler/" + name + ".miko");
            let stream = lexer.lex(source);
            let tree = parser.parse_program(stream);
            out = out + "Module " + name + "\n" + tree;
        }
        k = k + 1;
    }
    return out;
}

// ---- toolchain ------------------------------------------------------------
//
// Compiling a program should yield a runnable executable, not an intermediate
// .ll the user has to link by hand. To do that this compiler has to run clang,
// which needs machine-specific include and lib search paths for the C runtime
// (the runtime is C, so <stdio.h> must resolve).
//
// Those paths belong to the build, not to this source file: they differ between
// machines and between LLVM installs. The build writes them into a two-line
// file next to the compiler, read here at run time. Without that file the
// compiler still works - it falls back to whatever `clang` is on PATH, which is
// correct inside a Developer Command Prompt.

fn find_char_in(text: string, start: i64, target: char): i64 {
    let i = start;
    let n = len(text);
    while i < n {
        if char_at(text, i) == target {
            return i;
        }
        i = i + 1;
    }
    return n;
}

// Same search, but blind to text inside a string literal.
//
// The checks below look for structural punctuation ([, ], ; and so on) in the
// AST dump, and the dump prints a string literal with its quotes and its
// original contents. A line such as
//
//     let decl = " = private unnamed_addr constant [" + n + " x i8] c\"" + body
//
// therefore has a '[' and a ']' that belong to the *data* of the program, not to
// its structure. Searching quote-blind paired them up and then judged the text
// between them an index expression, which rejected a valid compiler source with
// "array index must be an integer, got a string".
//
// Returns len(text) when the character does not occur outside a literal.
fn find_char_outside_quotes(text: string, start: i64, target: char): i64 {
    let i = start;
    let n = len(text);
    let in_string: bool = false;
    while i < n {
        let ch = char_at(text, i);
        if in_string {
            if ch == '\\' {
                i = i + 2;
            } else {
                if ch == '"' {
                    in_string = false;
                }
                i = i + 1;
            }
        } else {
            if ch == '"' {
                in_string = true;
                i = i + 1;
            } else {
                if ch == target {
                    return i;
                }
                i = i + 1;
            }
        }
    }
    return n;
}

// Drop leading/trailing spaces, CR, LF and tabs.
fn trim_line(text: string): string {
    let start = 0;
    let n = len(text);
    let go = true;
    while start < n && go {
        let c = char_at(text, start);
        if c == ' ' || c == '\r' || c == '\n' || c == '\t' {
            start = start + 1;
        } else {
            go = false;
        }
    }
    return trim_line_from(text, start);
}

fn trim_line_from(text: string, start: i64): string {
    let end = len(text);
    while end > start {
        let c = char_at(text, end - 1);
        if c == ' ' || c == '\r' || c == '\n' || c == '\t' {
            end = end - 1;
        } else {
            return substring(text, start, end - start);
        }
    }
    return "";
}

fn nth_line(text: string, index: i64): string {
    let seen: i64 = 0;
    let start: i64 = 0;
    let n = len(text);
    let i: i64 = 0;
    let done = false;
    while i <= n && !done {
        let at_break = i == n;
        if !at_break {
            if char_at(text, i) == '\n' {
                at_break = true;
            }
        }
        if at_break {
            if seen == index {
                return substring(text, start, i - start);
            }
            seen = seen + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

// Where the build recorded the link script.
//
// The compiler cannot discover its own location at run time (the language
// exposes arguments, not argv[0]), so the config is looked for in the places a
// build puts it. `miko.toolchain` in the working directory wins, so a user can
// point this compiler at a different toolchain without rebuilding it.
fn link_script_path(): string {
    let candidates = "miko.toolchain\ndist/miko.toolchain\nbuild/miko.toolchain\n";
    let k: i64 = 0;
    while k < 3 {
        let path = nth_line(candidates, k);
        if path != "" {
            if file_exists(path) {
                let text = read_file(path);
                let stop = find_char_in(text, 0, '\n');
                let script = trim_line(substring(text, 0, stop));
                if script != "" {
                    return script;
                }
            }
        }
        k = k + 1;
    }
    return "";
}

fn digits_of(value: i64): string {
    if value == 0 {
        return "0";
    }
    let digits = "";
    let v = value;
    while v > 0 {
        let d = v % 10;
        digits = substring("0123456789", d, 1) + digits;
        v = v / 10;
    }
    return digits;
}

// Whether `text` ends with `suffix`.
fn ends_with(text: string, suffix: string): bool {
    let a = len(text);
    let b = len(suffix);
    if b > a {
        return false;
    }
    if b == 0 {
        return true;
    }
    return substring(text, a - b, b) == suffix;
}

// Turn <prefix>.ll into a native executable. Returns the command's exit status.
//
// Platform decisions are read from the toolchain script itself rather than
// guessed: a `.bat` script means the Windows command processor, where output
// carries `.exe` and a command line starting with a quote has to be guarded by
// `call` (cmd.exe would otherwise strip the first and last quote and scatter the
// arguments). Any other script is a POSIX shell script: no extension, no `call`.
//
// With no toolchain configured the plain clang command is used, and the same
// `.bat`-or-not distinction picks the output name.
fn link_executable(output_prefix: string): i64 {
    let script = link_script_path();
    let windows = ends_with(script, ".bat");
    let exe_suffix = "";
    if windows {
        exe_suffix = ".exe";
    }
    if script == "" {
        // No recorded toolchain: treat the host as POSIX unless a Windows
        // system directory is visible, which keeps the old behaviour when
        // running from a Windows checkout with no config file.
        if file_exists("C:\\Windows") {
            exe_suffix = ".exe";
        }
    }
    let ir = output_prefix + ".ll";
    let exe = output_prefix + exe_suffix;
    if script == "" {
        // -lm only where libm is a separate library. On Windows the math functions
        // live in the CRT and clang forwards the flag to lld-link, which then fails
        // with "could not open 'm.lib'" - so every compile failed on a Windows
        // checkout that had no toolchain file yet, which is exactly the state of a
        // fresh clone. The script path below decides the platform itself; this only
        // matters on the fallback.
        if file_exists("C:\\Windows") {
            return run_command("clang \"" + ir + "\" runtime/miko_runtime.c -o \"" + exe + "\"");
        }
        return run_command("clang \"" + ir + "\" runtime/miko_runtime.c -o \"" + exe + "\" -lm");
    }
    if windows {
        return run_command("call \"" + script + "\" \"" + ir + "\" \"" + exe + "\"");
    }
    return run_command("\"" + script + "\" \"" + ir + "\" \"" + exe + "\"");
}

// ---- const enforcement -----------------------------------------------------
//
// compiler/sema.miko only *describes* a program: it writes a report of inferred
// types and never rejects anything, and compile_file then discards that report.
// A `const` reassignment therefore compiled and ran, printing the new value,
// while the C++ frontend refused the same program. This pass is the missing
// check: it walks the tree keeping the const names of the current function and
// reports an assignment to one of them.

fn const_line_name(line: string, prefix_len: i64): string {
    if len(line) <= prefix_len {
        return "";
    }
    return trim_line(substring(line, prefix_len, len(line) - prefix_len));
}

fn imp_is_name_char(ch: char): bool {
    if ch >= 'a' && ch <= 'z' {
        return true;
    }
    if ch >= 'A' && ch <= 'Z' {
        return true;
    }
    if ch >= '0' && ch <= '9' {
        return true;
    }
    return ch == '_';
}

// The identifier an assignment target is rooted at: `nums [ 0 ]` -> `nums`,
// `p . x` -> `p`, `total` -> `total`. Writing through an element or a field is
// still a write to the binding, so the const check has to look at the base name
// rather than the whole target text.
fn assign_target_base(text: string): string {
    let n = len(text);
    let i: i64 = 0;
    while i < n {
        if !imp_is_name_char(char_at(text, i)) {
            return substring(text, 0, i);
        }
        i = i + 1;
    }
    return text;
}

// Returns "" when the program is fine, otherwise the offending message.
fn check_const_assignments(tree: string): string {
    let consts = "";
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Function ") {
            // A new function body cannot assign to a const from another one.
            consts = "\n";
        }
        if imp_starts(line, "Const ") {
            let name = const_line_name(line, 6);
            if name != "" {
                consts = consts + name + "\n";
            }
        }
        if imp_starts(line, "Assign ") {
            // The assignment carries its target in the child `Expr lhs = rhs`.
            let child = imp_line_at(tree, imp_next_line(tree, i));
            if imp_starts(child, "Expr ") {
                let text = trim_line(substring(child, 5, len(child) - 5));
                let eq = find_char_in(text, 0, '=');
                if eq < len(text) {
                    let lhs = trim_line(substring(text, 0, eq));
                    let base = assign_target_base(lhs);
                    if imp_loaded(consts, base) {
                        return at_node("cannot assign to const variable '" + base + "'", tree, i);
                    }
                }
            }
        }
        i = imp_next_line(tree, i);
    }
    return "";
}

// ---- static checks the self-hosted front end was missing --------------------
//
// compiler/sema.miko is a stub: it reports inferred types and rejects nothing.
// The C++ frontend enforces a set of ordinary static rules, so the shipped
// compiler accepted programs the other engines refused - a silently wrong
// binary instead of a diagnostic. These passes close the gap for the rules the
// negative examples in examples/*_error.miko cover.

// An index must be an integer. `nums[true]` and `nums["a"]` used to compile and
// then read an address computed from 1 or from a pointer.
fn check_index_types(tree: string): string {
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        let open = find_char_outside_quotes(line, 0, '[');
        if open < len(line) {
            let close = find_char_outside_quotes(line, open + 1, ']');
            if close < len(line) {
                let inner = trim_line(substring(line, open + 1, close - open - 1));
                if inner == "true" || inner == "false" {
                    return at_node("array index must be an integer, got a bool", tree, i);
                }
                if len(inner) > 0 {
                    if char_at(inner, 0) == '"' {
                        return at_node("array index must be an integer, got a string", tree, i);
                    }
                }
            }
        }
        i = imp_next_line(tree, i);
    }
    return "";
}

fn all_digits(text: string): bool {
    if len(text) == 0 {
        return false;
    }
    let i: i64 = 0;
    let n = len(text);
    while i < n {
        let ch = char_at(text, i);
        if ch < '0' || ch > '9' {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Number of comma separated items inside the brackets of a list literal body.
fn count_list_items(inner: string): i64 {
    let text = trim_line(inner);
    if len(text) == 0 {
        return 0;
    }
    let items: i64 = 1;
    let i: i64 = 0;
    let n = len(text);
    while i < n {
        if char_at(text, i) == ',' {
            items = items + 1;
        }
        i = i + 1;
    }
    return items;
}

// `let nums: [i32; 4] = [1, 2, 3]` declares four slots and supplies three. The
// fourth stayed uninitialised and the program printed whatever was there.
fn check_array_lengths(tree: string): string {
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Type [") {
            let semi = find_char_in(line, 0, ';');
            if semi < len(line) {
                let close = find_char_in(line, semi + 1, ']');
                if close < len(line) {
                    let count_text = trim_line(substring(line, semi + 1, close - semi - 1));
                    if all_digits(count_text) {
                        let next = imp_line_at(tree, imp_next_line(tree, i));
                        if imp_starts(next, "Expr [") {
                            let lit_open = find_char_in(next, 0, '[');
                            let lit_close = find_char_in(next, lit_open + 1, ']');
                            let body = trim_line(substring(next, lit_open + 1, lit_close - lit_open - 1));
                            let supplied = count_list_items(body);
                            let declared = str_to_i64(count_text);
                            if supplied != declared {
                                return at_node("array of length " + count_text + " initialised with "
                                    + digits_of(supplied) + " element(s)", tree, i);
                            }
                        }
                    }
                }
            }
        }
        i = imp_next_line(tree, i);
    }
    return "";
}

// "Point|2" per line, one line per declared struct.
fn struct_field_counts(tree: string): string {
    let out = "";
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Struct ") {
            let name = trim_line(substring(line, 7, len(line) - 7));
            let count: i64 = 0;
            let j = imp_next_line(tree, i);
            let more = true;
            while more && j < n {
                let child = imp_line_at(tree, j);
                if imp_starts(child, "Field ") {
                    count = count + 1;
                    j = imp_next_line(tree, j);
                } else {
                    more = false;
                }
            }
            if name != "" {
                out = out + name + "|" + digits_of(count) + "\n";
            }
        }
        i = imp_next_line(tree, i);
    }
    return out;
}

fn struct_count_lookup(table: string, name: string): i64 {
    let needle = name + "|";
    let i: i64 = 0;
    let n = len(table);
    while i < n {
        let line = imp_line_at(table, i);
        if imp_starts(line, needle) {
            let digits = substring(line, len(needle), len(line) - len(needle));
            if all_digits(digits) {
                return str_to_i64(digits);
            }
            return -1;
        }
        i = imp_next_line(table, i);
    }
    return -1;
}

// The identifier just before `stop`, e.g. "Expr Point { x : 1 }" with stop at
// the brace yields "Point". Whitespace between the name and the brace has to be
// stepped over first, otherwise the scan stops right away and finds nothing.
fn word_before(text: string, stop: i64): string {
    // Step back over the whitespace that separates the name from `stop`.
    let start = stop;
    while start > 0 {
        if char_at(text, start - 1) == ' ' || char_at(text, start - 1) == '\t' {
            start = start - 1;
        } else {
            break;
        }
    }
    let first = start;
    while first > 0 {
        if imp_is_name_char(char_at(text, first - 1)) {
            first = first - 1;
        } else {
            break;
        }
    }
    if first == start {
        return "";
    }
    return substring(text, first, start - first);
}

fn count_char_from(text: string, from: i64, target: char): i64 {
    let hits: i64 = 0;
    let i = from;
    let n = len(text);
    while i < n {
        if char_at(text, i) == target {
            hits = hits + 1;
        }
        i = i + 1;
    }
    return hits;
}

// `Point { x: 10 }` where Point declares x and y. The missing field was left
// holding whatever the alloca contained.
fn check_struct_literals(tree: string): string {
    let counts = struct_field_counts(tree);
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        let brace = find_char_in(line, 0, '{');
        if brace < len(line) {
            let name = word_before(line, brace);
            if len(name) > 0 {
                let declared = struct_count_lookup(counts, name);
                if declared >= 0 {
                    let supplied = count_char_from(line, brace, ':');
                    if supplied != declared {
                        return at_node("struct '" + name + "' literal supplies "
                            + digits_of(supplied) + " of " + digits_of(declared) + " field(s)", tree, i);
                    }
                }
            }
        }
        i = imp_next_line(tree, i);
    }
    return "";
}

// ---- name resolution -------------------------------------------------------
//
// The C++ frontend refuses an undefined identifier and a call with the wrong
// number of arguments before it emits anything. The self-hosted front end
// emitted IR for both, and that IR is well formed, so nothing downstream
// objected: `print(missing)` linked and printed 0, and a two-argument call to a
// one-parameter function linked and printed the first argument. A typo became a
// wrong answer with exit status 0, which is worse than any missing feature.
//
// The tree is a text stream, so this works in two passes: collect every name the
// program declares, then walk the uses and reject the ones that resolve to
// nothing. Scope is per function and flat - a name declared inside a block counts
// for the whole body - because a scope that is too coarse can only accept more,
// never reject a program the C++ frontend allows. That asymmetry is deliberate:
// a false rejection breaks working code, a missed rejection only leaves the old
// behaviour in place.

fn nr_is_primitive(name: string): bool {
    return name == "i32" || name == "i64" || name == "f32" || name == "f64"
        || name == "bool" || name == "char" || name == "string" || name == "void";
}

fn nr_is_keyword(name: string): bool {
    return name == "fn" || name == "let" || name == "const" || name == "if"
        || name == "else" || name == "while" || name == "for" || name == "return"
        || name == "break" || name == "continue" || name == "struct"
        || name == "enum" || name == "import" || name == "as" || name == "pub"
        || name == "extern" || name == "true" || name == "false";
}

// The identifier at the front of `text`: `a: i64` -> `a`, `nums [ 0 ]` -> `nums`.
fn nr_prefix_name(text: string): string {
    let n = len(text);
    let i: i64 = 0;
    while i < n && imp_is_name_char(char_at(text, i)) {
        i = i + 1;
    }
    return substring(text, 0, i);
}

fn nr_skip_space(text: string, from: i64): i64 {
    let n = len(text);
    let i = from;
    while i < n {
        let c = char_at(text, i);
        if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
            i = i + 1;
        } else {
            return i;
        }
    }
    return n;
}

fn nr_skip_back_space(text: string, from: i64): i64 {
    let i = from;
    while i >= 0 {
        let c = char_at(text, i);
        if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
            i = i - 1;
        } else {
            return i;
        }
    }
    return -1;
}

// "" when the name resolves, otherwise the diagnostic.
fn nr_resolve(name: string, start: i64, finish: i64, text: string,
              locals: string, globals: string): string {
    let before = nr_skip_back_space(text, start - 1);
    if before >= 0 {
        let c = char_at(text, before);
        // `p . x` selects a field and `Color :: Red` a variant. Neither is a
        // variable, and resolving either one needs type information this pass
        // does not have.
        if c == '.' || c == ':' {
            return "";
        }
    }
    let after = nr_skip_space(text, finish);
    // In `P { x : 1 }` the label is a field name, not a binding.
    if after < len(text) && char_at(text, after) == ':' {
        return "";
    }
    if nr_is_primitive(name) || nr_is_keyword(name) {
        return "";
    }
    if codegen_ll.is_builtin_name(name) {
        return "";
    }
    if nr_is_vec_api(name) {
        return "";
    }
    if imp_loaded(locals, name) || imp_loaded(globals, name) {
        return "";
    }
    if after < len(text) && char_at(text, after) == '(' {
        return "unknown function '" + name + "'";
    }
    return "undefined variable '" + name + "'";
}

// Walks one expression text and returns the first name that resolves to nothing.
fn nr_check_text(text: string, locals: string, globals: string): string {
    let n = len(text);
    let i: i64 = 0;
    while i < n {
        let ch = char_at(text, i);
        if ch == '"' || ch == '\'' {
            // Skip the literal whole: a string may contain words that look like
            // identifiers and a char literal may be any punctuation.
            let quote = ch;
            i = i + 1;
            let go = true;
            while i < n && go {
                let c = char_at(text, i);
                if c == '\\' {
                    i = i + 2;
                } else {
                    if c == quote {
                        go = false;
                    }
                    i = i + 1;
                }
            }
        } else {
            if imp_is_name_char(ch) {
                let start = i;
                while i < n && imp_is_name_char(char_at(text, i)) {
                    i = i + 1;
                }
                let first = char_at(text, start);
                // A number is not a name, and `1abc` cannot occur.
                if !(first >= '0' && first <= '9') {
                    let verdict = nr_resolve(substring(text, start, i - start),
                                             start, i, text, locals, globals);
                    if verdict != "" {
                        return verdict;
                    }
                }
            } else {
                i = i + 1;
            }
        }
    }
    return "";
}

// Number of top-level arguments in the first parenthesised group of `text`.
// Returns -1 when the group never closes, which only happens on input the parser
// already accepted, so the call is left alone rather than reported.
fn nr_arg_count(text: string): i64 {
    let n = len(text);
    let open = find_char_outside_quotes(text, 0, '(');
    if open >= n {
        return -1;
    }
    let depth: i64 = 0;
    let commas: i64 = 0;
    let seen: bool = false;
    let in_string: bool = false;
    let i = open;
    while i < n {
        let ch = char_at(text, i);
        if in_string {
            if ch == '\\' {
                i = i + 2;
            } else {
                if ch == '"' {
                    in_string = false;
                }
                i = i + 1;
            }
        } else {
            if ch == '"' {
                in_string = true;
                seen = true;
                i = i + 1;
            } else {
                if ch == '(' || ch == '[' || ch == '{' {
                    depth = depth + 1;
                    i = i + 1;
                } else {
                    if ch == ')' || ch == ']' || ch == '}' {
                        depth = depth - 1;
                        if depth == 0 {
                            if seen {
                                return commas + 1;
                            }
                            return 0;
                        }
                        i = i + 1;
                    } else {
                        if ch == ',' && depth == 1 {
                            commas = commas + 1;
                            i = i + 1;
                        } else {
                            if depth >= 1 && ch != ' ' && ch != '\t'
                                    && ch != '\r' && ch != '\n' {
                                seen = true;
                            }
                            i = i + 1;
                        }
                    }
                }
            }
        }
    }
    return -1;
}

// Arity for every call site in one expression text, including nested ones:
// `print(f(1, 2))` has to check `f`, not `print`. Returns "" when they all match.
fn nr_check_arity_in_text(text: string, table: string): string {
    let n = len(text);
    let i: i64 = 0;
    while i < n {
        let ch = char_at(text, i);
        if ch == '"' || ch == '\'' {
            let quote = ch;
            i = i + 1;
            let go = true;
            while i < n && go {
                let c = char_at(text, i);
                if c == '\\' {
                    i = i + 2;
                } else {
                    if c == quote {
                        go = false;
                    }
                    i = i + 1;
                }
            }
        } else {
            if imp_is_name_char(ch) {
                let start = i;
                while i < n && imp_is_name_char(char_at(text, i)) {
                    i = i + 1;
                }
                let after = nr_skip_space(text, i);
                if after < n && char_at(text, after) == '(' {
                    let name = substring(text, start, i - start);
                    let expected = nr_expected_text(table, name);
                    let before = nr_skip_back_space(text, start - 1);
                    let qualified = before >= 0 && char_at(text, before) == '.';
                    if expected != "" && !qualified {
                        let got = nr_arg_count(substring(text, after, n - after));
                        if got >= 0 && digits_of(got) != expected {
                            return "function '" + name + "' expects " + expected
                                + " argument(s), got " + digits_of(got);
                        }
                    }
                }
            } else {
                i = i + 1;
            }
        }
    }
    return "";
}

// The name a module is called by in this file. `import acme.math as pkg` gives
// `pkg` from the ImportAlias line, and `import core.io` with no `as` is called
// `io` - the last segment of the dotted path. Reading only ImportAlias made every
// un-aliased import look undefined.
fn nr_module_name(tree: string, i: i64, path: string): string {
    let after = imp_next_line(tree, i);
    let alias_line = imp_line_at(tree, after);
    if imp_starts(alias_line, "ImportAlias ") {
        return const_line_name(alias_line, 12);
    }
    let last = path;
    let dot = find_char_in(path, 0, '.');
    let from: i64 = 0;
    while dot < len(path) {
        from = dot + 1;
        dot = find_char_in(path, from, '.');
    }
    return substring(path, from, len(path) - from);
}

// `vec_*` are documented in README 5.8 but the LLVM backend has no runtime for
// them and says so. Rejecting them here as unknown names would replace that
// accurate diagnostic with a misleading one, so they are left to the backend.
fn nr_is_vec_api(name: string): bool {
    return name == "vec_new" || name == "vec_push" || name == "vec_pop"
        || name == "vec_get" || name == "vec_set" || name == "vec_len"
        || name == "vec_clear" || name == "vec_reserve";
}

// One `name|count` line per declared function.
fn nr_param_counts(tree: string): string {
    let table = "\n";
    let current = "";
    let count: i64 = 0;
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Function ") {
            if current != "" {
                table = table + current + "|" + digits_of(count) + "\n";
            }
            current = const_line_name(line, 9);
            count = 0;
        } else {
            if imp_starts(line, "Param ") {
                count = count + 1;
            } else {
                // Parameters are contiguous, so the first other line ends the
                // arity of the function that was open.
                if current != "" {
                    table = table + current + "|" + digits_of(count) + "\n";
                    current = "";
                }
            }
        }
        i = imp_next_line(tree, i);
    }
    if current != "" {
        table = table + current + "|" + digits_of(count) + "\n";
    }
    return table;
}

// The declared argument count of `name` as written in the table, or "".
fn nr_expected_text(table: string, name: string): string {
    let i: i64 = 0;
    let n = len(table);
    while i < n {
        let e = find_char_in(table, i, '\n');
        let row = substring(table, i, e - i);
        let bar = find_char_in(row, 0, '|');
        if bar < len(row) {
            if substring(row, 0, bar) == name {
                return substring(row, bar + 1, len(row) - bar - 1);
            }
        }
        i = e + 1;
    }
    return "";
}

// Returns "" when every name in the program resolves, otherwise the first
// diagnostic. Two passes: declarations, then uses.
fn check_name_resolution(tree: string): string {
    let globals = "\n";
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Function ") {
            globals = globals + const_line_name(line, 9) + "\n";
        }
        if imp_starts(line, "Struct ") {
            globals = globals + const_line_name(line, 7) + "\n";
        }
        if imp_starts(line, "Enum ") {
            globals = globals + const_line_name(line, 5) + "\n";
        }
        if imp_starts(line, "ImportAlias ") {
            globals = globals + const_line_name(line, 12) + "\n";
        }
        if imp_starts(line, "ImportPath ") {
            // Also covers the un-aliased form, where no ImportAlias line follows.
            let module_name = nr_module_name(tree, i, const_line_name(line, 11));
            if module_name != "" {
                globals = globals + module_name + "\n";
            }
        }
        i = imp_next_line(tree, i);
    }
    let table = nr_param_counts(tree);

    let locals = "\n";
    i = 0;
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Function ") {
            // A body cannot see another body's bindings.
            locals = "\n";
        }
        if imp_starts(line, "Param ") {
            locals = locals + nr_prefix_name(const_line_name(line, 6)) + "\n";
        }
        if imp_starts(line, "Let ") {
            locals = locals + nr_prefix_name(const_line_name(line, 4)) + "\n";
        }
        if imp_starts(line, "Const ") {
            locals = locals + nr_prefix_name(const_line_name(line, 6)) + "\n";
        }
        if imp_starts(line, "ForInit ") {
            // `ForInit let k = 0` declares the loop variable; the `Header` line
            // repeats it but arrives before this one, so it is not read.
            let init = const_line_name(line, 8);
            if imp_starts(init, "let ") {
                locals = locals + nr_prefix_name(substring(init, 4, len(init) - 4)) + "\n";
            }
        }

        let verdict = "";
        let node_line = imp_line_pos_at(tree, i);
        if imp_starts(line, "Assign ") {
            verdict = nr_check_text(const_line_name(line, 7), locals, globals);
        }
        if verdict == "" && imp_starts(line, "Left ") {
            verdict = nr_check_text(const_line_name(line, 5), locals, globals);
        }
        if verdict == "" && imp_starts(line, "Right ") {
            verdict = nr_check_text(const_line_name(line, 6), locals, globals);
        }
        if verdict == "" && imp_starts(line, "Expr ") {
            verdict = nr_check_text(const_line_name(line, 5), locals, globals);
        }
        if verdict == "" && imp_starts(line, "ForCondition ") {
            verdict = nr_check_text(const_line_name(line, 13), locals, globals);
        }
        if verdict == "" && imp_starts(line, "ForStep ") {
            verdict = nr_check_text(const_line_name(line, 8), locals, globals);
        }
        if verdict == "" && imp_starts(line, "Call ") {
            let call = const_line_name(line, 5);
            verdict = nr_check_text(call, locals, globals);
            if verdict == "" {
                // Arity only for functions this file declares: an imported
                // module's parameters are not in this tree.
                verdict = nr_check_arity_in_text(call, table);
            }
        }
        if verdict != "" {
            // The line rides along so report_error can point at it.
            if node_line > 0 {
                return verdict + " @" + digits_of(node_line);
            }
            return verdict;
        }
        i = imp_next_line(tree, i);
    }
    return "";
}

// ---- diagnostics -----------------------------------------------------------
//
// A message alone is nearly useless on a program of any size, and the C++
// frontend has always printed the location, the source line and a caret. The
// message now travels with the line it came from (the same "@line" suffix the
// parser puts on a node), and this renders it the way the other engine does:
//
//   error: undefined variable 'missing'
//    --> prog.miko:2:11
//     |
//   2 |     print(missing);
//     |           ^
//
// The column is the offset of the offending text within its own source line,
// which is exact for the identifier that caused the diagnostic.

// The source line exactly as written, indentation included, because the caret is
// placed by column and stripping the leading spaces would move it. Only the line
// terminator is removed.
fn line_text_of(source: string, line: i64): string {
    let n = len(source);
    let current: i64 = 1;
    let start: i64 = 0;
    while start < n {
        let e = find_char_in(source, start, '\n');
        if current == line {
            let raw = substring(source, start, e - start);
            let m = len(raw);
            if m > 0 && char_at(raw, m - 1) == '\r' {
                return substring(raw, 0, m - 1);
            }
            return raw;
        }
        current = current + 1;
        start = e + 1;
    }
    return "";
}

fn count_lines_upto(source: string, line: i64): string {
    return "";
}

// Offset of `needle` inside `line`, or -1.
fn column_of(name: string, line: string): i64 {
    let n = len(line);
    let m = len(name);
    if m == 0 {
        return -1;
    }
    let i: i64 = 0;
    while i + m <= n {
        let ok = true;
        let j: i64 = 0;
        while j < m {
            if char_at(line, i + j) != char_at(name, j) {
                ok = false;
                j = m;
            } else {
                j = j + 1;
            }
        }
        if ok {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn caret_pad(count: i64): string {
    let out = "";
    let i: i64 = 0;
    while i < count {
        out = out + " ";
        i = i + 1;
    }
    return out;
}

// `raw` is "message @line"; prints the message with its location.
fn report_error(source: string, path: string, raw: string) {
    let line = ast.line_pos(raw);
    let msg = ast.strip_pos(raw);
    eprint("error: " + msg);
    if line <= 0 {
        return;
    }
    let text = line_text_of(source, line);
    if text == "" {
        return;
    }
    // The name the message quotes is what the caret points at.
    let q1 = find_char_in(msg, 0, '\'');
    let head = " --> " + path + ":" + digits_of(line);
    if q1 >= len(msg) - 1 {
        eprint(head);
        return;
    }
    let q2 = find_char_in(msg, q1 + 1, '\'');
    let name = substring(msg, q1 + 1, q2 - q1 - 1);
    let col = column_of(name, text);
    if col < 0 {
        eprint(head);
        return;
    }
    eprint(head + ":" + digits_of(col + 1));
    eprint("  |");
    eprint(digits_of(line) + " | " + text);
    eprint("  | " + caret_pad(col) + "^");
}

// ---- type checking ---------------------------------------------------------
//
// Name resolution catches typos; it cannot catch a value of the wrong type.
// `f("s")` against `fn f(a: i64)` compiled to a call passing a pointer where an
// integer was declared, and the program ran, printed an address and exited 0.
// LLVM does not object because the IR is well formed - it just means something
// else. These rules reject that class of mistake before any IR is written.
//
// Every rule is written to accept when it is unsure. A type that cannot be
// inferred comes back as "" and "" is compatible with anything, because a false
// rejection breaks a working program while a missed one only keeps the old
// behaviour.

fn tc_is_digit(ch: char): bool {
    return ch >= '0' && ch <= '9';
}

fn tc_is_word_char(ch: char): bool {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || tc_is_digit(ch) || ch == '_';
}

fn tc_is_primitive(name: string): bool {
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" {
        return true;
    }
    if name == "u8" || name == "u16" || name == "u32" || name == "u64" {
        return true;
    }
    if name == "f32" || name == "f64" {
        return true;
    }
    if name == "bool" || name == "string" || name == "char" || name == "void" {
        return true;
    }
    return false;
}

fn tc_is_numeric(name: string): bool {
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" {
        return true;
    }
    if name == "u8" || name == "u16" || name == "u32" || name == "u64" {
        return true;
    }
    return name == "f32" || name == "f64";
}

// Two types agree when they are equal, when both are numeric, or when either is
// unknown. Anything else is a real mismatch.
// Numbers and bools are usable as conditions, the way C treats them; the C++
// frontend accepts `if 1` and rejects `if "s"` with "bool-compatible". Strings
// and aggregates are the ones that make no sense as a truth value.
fn tc_bad_condition(have: string): bool {
    if have == "" || have == "bool" {
        return false;
    }
    return !tc_is_numeric(have);
}

fn tc_compatible(have: string, want: string): bool {
    if have == "" || want == "" {
        return true;
    }
    if have == want {
        return true;
    }
    if tc_is_numeric(have) && tc_is_numeric(want) {
        return true;
    }
    return false;
}

fn tc_indent_at(tree: string, index: i64): i64 {
    let n = len(tree);
    if index >= n {
        return 0;
    }
    let e = find_char_in(tree, index, '\n');
    let spaces: i64 = 0;
    let j = index;
    while j < e && char_at(tree, j) == ' ' {
        spaces = spaces + 1;
        j = j + 1;
    }
    return spaces;
}

// "Point|x:i32,y:i32\nVector|x:f64,y:f64\n"
fn tc_struct_table(tree: string): string {
    let out = "";
    let current = "";
    let fields = "";
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Struct ") {
            if current != "" {
                out = out + current + "|" + fields + "\n";
            }
            current = const_line_name(line, 7);
            fields = "";
        } else if imp_starts(line, "Field ") {
            if current != "" {
                let spec = const_line_name(line, 6);
                let colon = find_char_in(spec, 0, ':');
                if colon < len(spec) {
                    let fname = trim_line(substring(spec, 0, colon));
                    let ftype = trim_line(substring(spec, colon + 1, len(spec) - colon - 1));
                    if fields != "" {
                        fields = fields + ",";
                    }
                    fields = fields + fname + ":" + ftype;
                }
            }
        } else if imp_starts(line, "Function ") || imp_starts(line, "Enum ") {
            if current != "" {
                out = out + current + "|" + fields + "\n";
                current = "";
                fields = "";
            }
        }
        i = imp_next_line(tree, i);
    }
    if current != "" {
        out = out + current + "|" + fields + "\n";
    }
    return out;
}

// "f|i64|i64,string\n" - name, return type, parameter types.
fn tc_fn_table(tree: string): string {
    let out = "";
    let current = "";
    let ret = "";
    let params = "";
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Function ") {
            if current != "" {
                out = out + current + "|" + ret + "|" + params + "\n";
            }
            current = const_line_name(line, 9);
            ret = "void";
            params = "";
        } else if imp_starts(line, "Param ") {
            if current != "" {
                let spec = const_line_name(line, 6);
                let colon = find_char_in(spec, 0, ':');
                if colon < len(spec) {
                    let ptype = trim_line(substring(spec, colon + 1, len(spec) - colon - 1));
                    if params != "" {
                        params = params + ",";
                    }
                    params = params + ptype;
                }
            }
        } else if imp_starts(line, "ReturnType ") {
            if current != "" {
                ret = trim_line(substring(line, 11, len(line) - 11));
            }
        } else if imp_starts(line, "Struct ") || imp_starts(line, "Enum ") || imp_starts(line, "Import ") {
            if current != "" {
                out = out + current + "|" + ret + "|" + params + "\n";
                current = "";
            }
        }
        i = imp_next_line(tree, i);
    }
    if current != "" {
        out = out + current + "|" + ret + "|" + params + "\n";
    }
    return out;
}

// ---- expression typing -----------------------------------------------------
//
// Expression nodes hold a flat token text ("p . x + 1"). The first atom decides
// the type, and a field chain or a call refines it.

fn tc_skip_space(text: string, i: i64): i64 {
    let n = len(text);
    let j = i;
    while j < n && char_at(text, j) == ' ' {
        j = j + 1;
    }
    return j;
}

fn tc_read_word(text: string, start: i64): string {
    let n = len(text);
    let j = start;
    while j < n && tc_is_word_char(char_at(text, j)) {
        j = j + 1;
    }
    return substring(text, start, j - start);
}

fn tc_lookup(table: string, key: string): string {
    let n = len(table);
    let start: i64 = 0;
    while start < n {
        let e = find_char_in(table, start, '\n');
        let entry = substring(table, start, e - start);
        let bar = find_char_in(entry, 0, '|');
        if bar < len(entry) {
            if substring(entry, 0, bar) == key {
                return substring(entry, bar + 1, len(entry) - bar - 1);
            }
        }
        start = e + 1;
    }
    return "";
}

// The declared type of `name` in a flat "name:type\n" table.
fn tc_lookup_local(table: string, key: string): string {
    let n = len(table);
    let start: i64 = 0;
    while start < n {
        let e = find_char_in(table, start, '\n');
        let entry = substring(table, start, e - start);
        let colon = find_char_in(entry, 0, ':');
        if colon < len(entry) {
            if substring(entry, 0, colon) == key {
                return substring(entry, colon + 1, len(entry) - colon - 1);
            }
        }
        start = e + 1;
    }
    return "";
}

fn tc_field_type(structs: string, struct_name: string, field: string): string {    let fields = tc_lookup(structs, struct_name);
    let n = len(fields);
    let start: i64 = 0;
    while start < n {
        let e = find_char_in(fields, start, ',');
        let entry = substring(fields, start, e - start);
        let colon = find_char_in(entry, 0, ':');
        if colon < len(entry) {
            if substring(entry, 0, colon) == field {
                return substring(entry, colon + 1, len(entry) - colon - 1);
            }
        }
        start = e + 1;
    }
    return "";
}

fn tc_nth_param(fns: string, fn_name: string, index: i64): string {
    let sig = tc_lookup(fns, fn_name);
    let bar = find_char_in(sig, 0, '|');
    if bar >= len(sig) {
        return "";
    }
    let params = substring(sig, bar + 1, len(sig) - bar - 1);
    if params == "" {
        return "";
    }
    let n = len(params);
    let start: i64 = 0;
    let k: i64 = 0;
    while start <= n {
        let e = find_char_in(params, start, ',');
        if k == index {
            return substring(params, start, e - start);
        }
        k = k + 1;
        start = e + 1;
    }
    return "";
}

fn tc_fn_ret(fns: string, fn_name: string): string {
    let sig = tc_lookup(fns, fn_name);
    let bar = find_char_in(sig, 0, '|');
    if bar >= len(sig) {
        return "";
    }
    return substring(sig, 0, bar);
}

// Type of one atom at the start of `text`, following a `.field` chain.
fn tc_atom_type(text: string, locals: string, structs: string, fns: string): string {
    let n = len(text);
    let i: i64 = tc_skip_space(text, 0);
    if i >= n {
        return "";
    }
    let ch = char_at(text, i);
    if ch == '"' {
        return "string";
    }
    if ch == '\'' {
        return "char";
    }
    if ch == '-' || tc_is_digit(ch) {
        let j: i64 = i + 1;
        let is_float = false;
        while j < n {
            let c = char_at(text, j);
            if c == '.' {
                is_float = true;
                j = j + 1;
            } else if tc_is_digit(c) || c == '_' {
                j = j + 1;
            } else {
                j = n;
            }
        }
        if is_float {
            return "f64";
        }
        return "i64";
    }
    let word = tc_read_word(text, i);
    if word == "" {
        return "";
    }
    if word == "true" || word == "false" {
        return "bool";
    }
    let j: i64 = tc_skip_space(text, i + len(word));
    if j < n && char_at(text, j) == '(' {
        return tc_fn_ret(fns, word);
    }
    let current = tc_lookup_local(locals, word);
    if current == "" {
        // A bare name matching a struct is the start of a struct literal.
        if tc_lookup(structs, word) != "" {
            current = word;
        } else {
            return "";
        }
    }
    // Walk the field chain: `p.x` is the type of field x of p's struct.
    let cursor: i64 = j;
    while cursor < n && char_at(text, cursor) == '.' {
        let fstart: i64 = tc_skip_space(text, cursor + 1);
        let field = tc_read_word(text, fstart);
        if field == "" {
            return "";
        }
        let next = tc_field_type(structs, current, field);
        if next == "" {
            return "";
        }
        current = next;
        cursor = tc_skip_space(text, fstart + len(field));
    }
    return current;
}

// First top-level occurrence of any character in `ops`, or len(text).
fn tc_find_top_op(text: string, ops: string): i64 {
    let n = len(text);
    let i: i64 = 0;
    let depth: i64 = 0;
    let quote: char = ' ';
    while i < n {
        let ch = char_at(text, i);
        if quote != ' ' {
            if ch == quote {
                quote = ' ';
            }
            i = i + 1;
            continue;
        }
        if ch == '"' || ch == '\'' {
            quote = ch;
            i = i + 1;
            continue;
        }
        if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1;
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1;
        } else if depth == 0 {
            let k: i64 = 0;
            while k < len(ops) {
                if ch == char_at(ops, k) {
                    return i;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

// Type of a whole expression: a comparison yields bool, arithmetic keeps the
// operand type, a single atom is itself. Typing the operands rather than the
// whole text is what keeps `p.x + p.y` from being read as type `p`.
fn tc_type_of(text: string, locals: string, structs: string, fns: string): string {
    if tc_find_top_op(text, "<>") < len(text) {
        return "bool";
    }
    let eq = tc_find_top_op(text, "=");
    if eq < len(text) && eq + 1 < len(text) && char_at(text, eq + 1) == '=' {
        return "bool";
    }
    let bang = tc_find_top_op(text, "!");
    if bang < len(text) {
        return "bool";
    }
    let arith = tc_find_top_op(text, "+-*/%");
    if arith < len(text) {
        let left = tc_type_of(substring(text, 0, arith), locals, structs, fns);
        if left != "" {
            return left;
        }
        return tc_type_of(substring(text, arith + 1, len(text) - arith - 1), locals, structs, fns);
    }
    return tc_atom_type(text, locals, structs, fns);
}

// The declared type in a `Type ...` node: "i32", "Point", "[ i32 ; 3 ]".
fn tc_declared_type(type_text: string): string {
    let t = trim_line(type_text);
    if t == "" {
        return "";
    }
    if char_at(t, 0) == '[' {
        // Element type of an array, so `nums[i]` still types.
        let close = find_char_in(t, 1, ']');
        let inner = trim_line(substring(t, 1, close - 1));
        let semi = find_char_in(inner, 0, ';');
        if semi < len(inner) {
            return trim_line(substring(inner, 0, semi));
        }
        return inner;
    }
    let space = find_char_in(t, 0, ' ');
    if space < len(t) {
        return substring(t, 0, space);
    }
    return t;
}

// Index of the ')' matching the '(' at `open`, or len(text).
fn tc_match_paren(text: string, open: i64): i64 {
    let n = len(text);
    let depth: i64 = 0;
    let i = open;
    let quote: char = ' ';
    while i < n {
        let ch = char_at(text, i);
        if quote != ' ' {
            if ch == quote {
                quote = ' ';
            }
            i = i + 1;
            continue;
        }
        if ch == '"' || ch == '\'' {
            quote = ch;
        } else if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1;
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return n;
}

// Splits at top-level separators, returning "\n"-joined items.
fn tc_split_top(text: string, sep: char): string {
    let n = len(text);
    let out = "";
    let start: i64 = 0;
    let depth: i64 = 0;
    let quote: char = ' ';
    let i: i64 = 0;
    while i < n {
        let ch = char_at(text, i);
        if quote != ' ' {
            if ch == quote {
                quote = ' ';
            }
            i = i + 1;
            continue;
        }
        if ch == '"' || ch == '\'' {
            quote = ch;
        } else if ch == '(' || ch == '[' || ch == '{' {
            depth = depth + 1;
        } else if ch == ')' || ch == ']' || ch == '}' {
            depth = depth - 1;
        } else if ch == sep && depth == 0 {
            out = out + trim_line(substring(text, start, i - start)) + "\n";
            start = i + 1;
        }
        i = i + 1;
    }
    let tail = trim_line(substring(text, start, n - start));
    if tail != "" {
        out = out + tail + "\n";
    }
    return out;
}

fn tc_list_count(list: string): i64 {
    let n = len(list);
    if n == 0 {
        return 0;
    }
    let count: i64 = 0;
    let start: i64 = 0;
    while start < n {
        let e = find_char_in(list, start, '\n');
        if e > start {
            count = count + 1;
        }
        start = e + 1;
    }
    return count;
}

fn tc_list_at(list: string, index: i64): string {
    let n = len(list);
    let start: i64 = 0;
    let k: i64 = 0;
    while start < n {
        let e = find_char_in(list, start, '\n');
        if k == index {
            return substring(list, start, e - start);
        }
        k = k + 1;
        start = e + 1;
    }
    return "";
}

fn tc_enum_exists(tree: string, name: string): bool {
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "Enum ") {
            if const_line_name(line, 5) == name {
                return true;
            }
        }
        i = imp_next_line(tree, i);
    }
    return false;
}

// The members of `enum Name`, comma joined, or "" when there is no such enum.
fn tc_list_has(list: string, item: string): bool {
    let n = len(list);
    let start: i64 = 0;
    while start <= n {
        let e = find_char_in(list, start, ',');
        if substring(list, start, e - start) == item {
            return true;
        }
        start = e + 1;
    }
    return false;
}

fn tc_enum_members(tree: string, name: string): string {
    let i: i64 = 0;
    let n = len(tree);
    let inside = false;
    let out = "";
    while i < n {
        let line = imp_line_at(tree, i);
        let d: i64 = tc_indent_at(tree, i);
        if imp_starts(line, "Enum ") {
            if inside {
                return out;
            }
            inside = const_line_name(line, 5) == name;
            if inside {
                i = imp_next_line(tree, i);
                while i < n {
                    let inner = imp_line_at(tree, i);
                    if imp_starts(inner, "Member ") {
                        if out != "" {
                            out = out + ",";
                        }
                        out = out + const_line_name(inner, 7);
                    } else if tc_indent_at(tree, i) <= d {
                        return out;
                    }
                    i = imp_next_line(tree, i);
                }
                return out;
            }
        }
        i = imp_next_line(tree, i);
    }
    return out;
}

// Field access and enum variants need the tables, and both used to reach LLVM
// with an internal IR message instead of naming the field the user wrote.
fn tc_check_members(text: string, locals: string, structs: string, tree: string): string {
    let n = len(text);
    let i: i64 = 0;
    let quote: char = ' ';
    while i < n {
        let ch = char_at(text, i);
        if quote != ' ' {
            if ch == quote {
                quote = ' ';
            }
            i = i + 1;
            continue;
        }
        if ch == '"' || ch == '\'' {
            quote = ch;
            i = i + 1;
            continue;
        }
        if tc_is_word_char(ch) && (i == 0 || !tc_is_word_char(char_at(text, i - 1))) {
            let word = tc_read_word(text, i);
            if word != "" {
                let after = tc_skip_space(text, i + len(word));
                if after < n && char_at(text, after) == ':' && after + 1 < n && char_at(text, after + 1) == ':' {
                    // Enum variant: the enum must exist and list the member.
                    let mstart = tc_skip_space(text, after + 2);
                    let member = tc_read_word(text, mstart);
                    let members = tc_enum_members(tree, word);
                    if member != "" && members != "" && !tc_list_has(members, member) {
                        return "enum '" + word + "' has no member '" + member + "'";
                    }
                } else if after < n && char_at(text, after) == '.' {
                    let fstart = tc_skip_space(text, after + 1);
                    let field = tc_read_word(text, fstart);
                    let base_ty = tc_lookup_local(locals, word);
                    if field != "" && base_ty != "" && tc_lookup(structs, base_ty) != "" {
                        if tc_field_type(structs, base_ty, field) == "" {
                            return "struct '" + base_ty + "' has no field '" + field + "'";
                        }
                    }
                }
                i = i + len(word);
                continue;
            }
        }
        i = i + 1;
    }
    return "";
}

// Checks every call site in a node's text against the declared parameter types.
fn tc_check_calls(text: string, locals: string, structs: string, fns: string): string {
    let n = len(text);
    let i: i64 = 0;
    let quote: char = ' ';
    while i < n {
        let ch = char_at(text, i);
        if quote != ' ' {
            if ch == quote {
                quote = ' ';
            }
            i = i + 1;
            continue;
        }
        if ch == '"' || ch == '\'' {
            quote = ch;
            i = i + 1;
            continue;
        }
        if tc_is_word_char(ch) && (i == 0 || !tc_is_word_char(char_at(text, i - 1))) {
            let word = tc_read_word(text, i);
            if word != "" {
                let j: i64 = tc_skip_space(text, i + len(word));
                if j < n && char_at(text, j) == '(' {
                    if tc_lookup(fns, word) != "" {
                        let close = tc_match_paren(text, j);
                        let inner = substring(text, j + 1, close - j - 1);
                        let args = tc_split_top(inner, ',');
                        let count: i64 = tc_list_count(args);
                        let k: i64 = 0;
                        while k < count {
                            let want = tc_nth_param(fns, word, k);
                            let have = tc_type_of(tc_list_at(args, k), locals, structs, fns);
                            if !tc_compatible(have, want) {
                                return "argument " + digits_of(k + 1) + " of '" + word + "': expected '" + want + "', got '" + have + "'";
                            }
                            k = k + 1;
                        }
                    } else if tc_is_primitive(tc_lookup_local(locals, word)) {
                        // A variable holding an integer is not callable. Only
                        // claimed for primitive types, so a field holding a
                        // function value is left alone.
                        return "'" + word + "' is a variable of type '" + tc_lookup_local(locals, word) + "', not a function";
                    }
                }
                i = i + len(word);
                continue;
            }
        }
        i = i + 1;
    }
    return "";
}

// The expression text inside a value node, with the node keyword removed.
fn tc_payload(node_line: string): string {
    if imp_starts(node_line, "Expr ") {
        return trim_line(substring(node_line, 5, len(node_line) - 5));
    }
    if imp_starts(node_line, "Call ") {
        return trim_line(substring(node_line, 5, len(node_line) - 5));
    }
    if imp_starts(node_line, "Binary ") {
        return trim_line(substring(node_line, 7, len(node_line) - 7));
    }
    return "";
}

// The condition text of an `If`/`While`: the expression sits beside the
// `Condition` marker, one level below the header.
fn tc_condition_text(tree: string, index: i64, indent: i64): string {
    let n = len(tree);
    let j: i64 = imp_next_line(tree, index);
    while j < n {
        let d: i64 = tc_indent_at(tree, j);
        if d <= indent {
            return "";
        }
        let line = imp_line_at(tree, j);
        if d == indent + 2 {
            if imp_starts(line, "Condition") {
                let k: i64 = imp_next_line(tree, j);
                if k < n {
                    return tc_payload(imp_line_at(tree, k));
                }
                return "";
            }
        }
        j = imp_next_line(tree, j);
    }
    return "";
}

fn check_types(tree: string): string {
    let structs = tc_struct_table(tree);
    let fns = tc_fn_table(tree);
    let locals = "";
    let cur_ret = "void";
    let loop_depth: i64 = 0;
    let seen_fns = "\n";
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let indent = tc_indent_at(tree, i);
        let line = imp_line_at(tree, i);

        if imp_starts(line, "Function ") {
            let fname = const_line_name(line, 9);
            if fname != "" && imp_loaded(seen_fns, fname) {
                return at_node("function '" + fname + "' is defined more than once", tree, i);
            }
            seen_fns = seen_fns + fname + "\n";
            locals = "";
            cur_ret = "void";
            loop_depth = 0;
        }

        if imp_starts(line, "Param ") {
            let spec = const_line_name(line, 6);
            let colon = find_char_in(spec, 0, ':');
            if colon < len(spec) {
                let pname = trim_line(substring(spec, 0, colon));
                let ptype = tc_declared_type(substring(spec, colon + 1, len(spec) - colon - 1));
                if pname != "" && ptype != "" {
                    locals = locals + pname + ":" + ptype + "\n";
                }
            }
        }

        if imp_starts(line, "ReturnType ") {
            cur_ret = tc_declared_type(substring(line, 11, len(line) - 11));
        }

        if imp_starts(line, "While") || imp_starts(line, "For") {
            loop_depth = loop_depth + 1;
        }
        if line == "EndWhile" || line == "EndFor" {
            loop_depth = loop_depth - 1;
        }

        if line == "break" || line == "continue" {
            if loop_depth <= 0 {
                return at_node("'" + line + "' outside of a loop", tree, i);
            }
        }

        if imp_starts(line, "Let ") || imp_starts(line, "Const ") {
            let offset: i64 = 4;
            if imp_starts(line, "Const ") {
                offset = 6;
            }
            let name = const_line_name(line, offset);
            let type_text = "";
            let value_text = "";
            let j: i64 = imp_next_line(tree, i);
            let stop = false;
            while j < n && !stop {
                let d = tc_indent_at(tree, j);
                if d <= indent {
                    stop = true;
                } else {
                    let child = imp_line_at(tree, j);
                    // The tree indents two spaces per level, so a direct child of
                    // this node sits at indent + 2.
                    if d == indent + 2 {
                        if imp_starts(child, "Type ") && type_text == "" {
                            type_text = trim_line(substring(child, 5, len(child) - 5));
                        }
                        if value_text == "" {
                            if imp_starts(child, "Expr ") || imp_starts(child, "Call ") || imp_starts(child, "Binary ") {
                                value_text = child;
                            }
                        }
                    }
                    j = imp_next_line(tree, j);
                }
            }
            let want = tc_declared_type(type_text);
            if want != "" && type_text != "" {
                let known = tc_is_primitive(want) || tc_lookup(structs, want) != "" || tc_enum_exists(tree, want);
                if !known {
                    return at_node("unknown type '" + want + "' for variable '" + name + "'", tree, i);
                }
            }
            if want != "" && value_text != "" {
                let have = tc_type_of(tc_payload(value_text), locals, structs, fns);
                if !tc_compatible(have, want) {
                    return at_node("cannot initialize variable '" + name + "' of type '" + want + "' with '" + have + "'", tree, i);
                }
            }
            if name != "" && want != "" {
                locals = locals + name + ":" + want + "\n";
            }
        }

        if imp_starts(line, "Return") {
            let j: i64 = imp_next_line(tree, i);
            if j < n && tc_indent_at(tree, j) > indent {
                let child = imp_line_at(tree, j);
                if imp_starts(child, "Expr ") || imp_starts(child, "Call ") || imp_starts(child, "Binary ") {
                    let have = tc_type_of(tc_payload(child), locals, structs, fns);
                    if cur_ret == "void" {
                        return at_node("'return' with a value in a function that returns nothing", tree, i);
                    }
                    if !tc_compatible(have, cur_ret) {
                        return at_node("function returns '" + cur_ret + "' but 'return' supplies '" + have + "'", tree, i);
                    }
                }
            }
        }

        if imp_starts(line, "Assign ") {
            let name = const_line_name(line, 7);
            let j: i64 = imp_next_line(tree, i);
            // The `Expr lhs = rhs` payload is a sibling of the Assign node, not a
            // child: both sit at the same depth, so `>` would skip it.
            if j < n && tc_indent_at(tree, j) >= indent {
                let child = imp_line_at(tree, j);
                if imp_starts(child, "Expr ") {
                    let text = trim_line(substring(child, 5, len(child) - 5));
                    let eq = find_char_in(text, 0, '=');
                    if eq < len(text) {
                        let want = tc_lookup_local(locals, name);
                        let rhs = trim_line(substring(text, eq + 1, len(text) - eq - 1));
                        let have = tc_type_of(rhs, locals, structs, fns);
                        if want != "" && !tc_compatible(have, want) {
                            return at_node("cannot assign '" + have + "' to variable '" + name + "' of type '" + want + "'", tree, i);
                        }
                    }
                }
            }
        }

        if imp_starts(line, "If") || imp_starts(line, "While") {
            let cond = tc_condition_text(tree, i, indent);
            if cond != "" {
                let have = tc_type_of(cond, locals, structs, fns);
                if tc_bad_condition(have) {
                    return at_node("if condition must be bool-compatible, got '" + have + "'", tree, i);
                }
            }
        }

        if imp_starts(line, "ForCondition ") {
            let cond = trim_line(substring(line, 13, len(line) - 13));
            if cond != "" {
                let have = tc_type_of(cond, locals, structs, fns);
                if tc_bad_condition(have) {
                    return at_node("if condition must be bool-compatible, got '" + have + "'", tree, i);
                }
            }
        }

        if imp_starts(line, "Expr ") || imp_starts(line, "Call ") || imp_starts(line, "Binary ") || imp_starts(line, "Left ") || imp_starts(line, "Right ") {
            let payload = tc_payload(line);
            let verdict = tc_check_calls(payload, locals, structs, fns);
            if verdict != "" {
                return at_node(verdict, tree, i);
            }
            let member = tc_check_members(payload, locals, structs, tree);
            if member != "" {
                return at_node(member, tree, i);
            }
        }

        i = imp_next_line(tree, i);
    }
    return "";
}

// Binds a message to the node that caused it, so report_error can point at the
// line the user wrote rather than only naming the problem.
fn at_node(message: string, tree: string, index: i64): string {
    let line = imp_line_pos_at(tree, index);
    if line <= 0 {
        return message;
    }
    return message + " @" + digits_of(line);
}

// Runs every static rule and returns the first violation, or "".
fn check_static_rules(tree: string): string {
    let error = check_name_resolution(tree);
    if error != "" {
        return error;
    }
    error = check_types(tree);
    if error != "" {
        return error;
    }
    error = check_const_assignments(tree);
    if error != "" {
        return error;
    }
    error = check_index_types(tree);
    if error != "" {
        return error;
    }
    error = check_array_lengths(tree);
    if error != "" {
        return error;
    }
    return check_struct_literals(tree);
}

// ---- import resolution -----------------------------------------------------
//
// A user program's `import` lines used to be ignored: the driver parsed only
// the file it was handed, so a call to `math.abs_i64` was mangled into
// `math__abs_i64` while nothing ever emitted that definition. clang then
// rejected the module with "use of undefined value '@math__abs_i64'".
//
// Each imported module is now loaded, parsed and emitted as its own
// `Module <alias>` section - the same shape `combine_modules` already used for
// self-hosting - so the definition is mangled the same way the call is.

fn imp_starts(text: string, prefix: string): bool {
    let p = len(prefix);
    if len(text) < p {
        return false;
    }
    let i: i64 = 0;
    while i < p {
        if char_at(text, i) != char_at(prefix, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn imp_next_line(text: string, index: i64): i64 {
    let n = len(text);
    if index >= n {
        return n;
    }
    let e = find_char_in(text, index, '\n');
    if e >= n {
        return n;
    }
    return e + 1;
}

// The source line of the node starting at `index`, or 0 when it has none. Read
// from the raw line because imp_line_at strips the position on the way out.
fn imp_line_pos_at(text: string, index: i64): i64 {
    let n = len(text);
    if index >= n {
        return 0;
    }
    let e = find_char_in(text, index, '\n');
    return ast.line_pos(substring(text, index, e - index));
}

fn imp_line_at(text: string, index: i64): string {
    let n = len(text);
    if index >= n {
        return "";
    }
    let e = find_char_in(text, index, '\n');
    return ast.strip_pos(trim_line(substring(text, index, e - index)));
}

// "core.math" -> "<root>/core/math.miko"
fn imp_dotted_to_path(root: string, name: string): string {
    let out = root;
    if len(name) > 0 {
        out = out + "/";
    }
    let i: i64 = 0;
    let n = len(name);
    while i < n {
        let ch = char_at(name, i);
        if ch == '.' {
            out = out + "/";
        } else {
            out = out + substring(name, i, 1);
        }
        i = i + 1;
    }
    return out + ".miko";
}

fn imp_stdlib_root(): string {
    if file_exists("stdlib/core/math.miko") {
        return "stdlib";
    }
    return "../stdlib";
}

fn imp_alias_of(dotted: string): string {
    let dot = find_char_in(dotted, 0, '.');
    if dot < len(dotted) {
        return substring(dotted, 0, dot);
    }
    return dotted;
}

fn imp_resolve(dotted: string): string {
    let direct = imp_dotted_to_path(imp_stdlib_root(), dotted);
    if file_exists(direct) {
        return direct;
    }
    let dot = find_char_in(dotted, 0, '.');
    if dot < len(dotted) {
        let pkg = substring(dotted, 0, dot);
        let rest = substring(dotted, dot + 1, len(dotted) - dot - 1);
        let in_src = imp_dotted_to_path("packages/" + pkg + "/src", rest);
        if file_exists(in_src) {
            return in_src;
        }
        let at_root = imp_dotted_to_path("packages/" + pkg, rest);
        if file_exists(at_root) {
            return at_root;
        }
    }
    return direct;
}

fn imp_loaded(list: string, name: string): bool {
    let i: i64 = 0;
    let n = len(list);
    while i < n {
        let e = find_char_in(list, i, '\n');
        if substring(list, i, e - i) == name {
            return true;
        }
        i = e + 1;
    }
    return false;
}

// Returns the concatenated `Module <alias>` sections for everything the tree
// imports. `seen` is the set of aliases already emitted.
fn imp_gather(tree: string, seen: string): string {
    let out = "";
    let marks = seen;
    let i: i64 = 0;
    let n = len(tree);
    while i < n {
        let line = imp_line_at(tree, i);
        if imp_starts(line, "ImportPath ") {
            let dotted = trim_line(substring(line, 11, len(line) - 11));
            let alias = imp_alias_of(dotted);
            if !imp_loaded(marks, alias) {
                marks = marks + alias + "\n";
                let path = imp_resolve(dotted);
                if file_exists(path) {
                    let sub = parser.parse_program(lexer.lex(read_file(path)));
                    out = out + "Module " + alias + "\n" + sub;
                } else {
                    eprint("miko: cannot find module '" + dotted + "'");
                }
            }
        }
        i = imp_next_line(tree, i);
    }
    return out;
}

// Single-file mode: `miko <input.miko> <output-prefix>` emits <prefix>.ll and
// links <prefix>.exe. `--emit-ir` stops at the IR.
fn compile_file(source_path: string, output_prefix: string, want_exe: bool): i32 {
    let source = read_file(source_path);
    let stream = lexer.lex(source);
    let tree = parser.parse_program(stream);
    // Emit the parse tree next to the IR, the way --self does. Without it a
    // failure to resolve an import is invisible: the tree is the only place the
    // ImportPath lines the driver searches for can be inspected.
    write_file(output_prefix + ".ast", tree);
    let checked = sema.check_program(tree);
    write_file(output_prefix + ".sema", checked);
    let error = check_static_rules(tree);
    if error != "" {
        report_error(source, source_path, error);
        print("failed");
        return 1;
    }
    let imported = imp_gather(tree, "");
    let ir = codegen_ll.generate_ir(imported + "Module " + "program" + "\n" + tree);
    write_file(output_prefix + ".ll", ir);
    if want_exe {
        let status = link_executable(output_prefix);
        if status != 0 {
            eprint("miko: linking failed with exit status " + digits_of(status));
            eprint("miko: the .ll was written; check miko.toolchain for the clang paths");
            print("failed");
            return 1;
        }
    }
    // One word, because the previous two lines both said "wrote" and one of them
    // said "<prefix>.exe" on platforms where the binary has no extension at all.
    // Naming the outputs is what introduced that lie; the caller supplied the
    // prefix and can look.
    print("success");
    return 0;
}

fn compile_self_to(prefix: string) {
    let tree = combine_modules();
    write_file(prefix + ".ast", tree);
    let checked = sema.check_program(tree);
    write_file(prefix + ".sema", checked);
    let ir = codegen_ll.generate_ir(tree);
    write_file(prefix + ".ll", ir);
    print("success");
}

fn compile_self() {
    compile_self_to("out/whole_program");
}

fn usage() {
    print("miko - a miko compiler written in miko");
    print("");
    print("usage:");
    print("  miko --version              print the version");
    print("  miko --help                 print this text");
    print("  miko --self [prefix]        compile the whole compiler to <prefix>.ll");
    print("  miko <src.miko> <prefix>    compile one program and link it");
    print("  miko                        same as --self with prefix out/whole_program");
    print("");
    print("compiling a program is a single step: <prefix>.ll is emitted and linked");
    print("against runtime/miko_runtime.c. The binary is <prefix>, plus .exe on");
    print("Windows. On success the compiler prints one word: success.");
    print("");
    print("add --emit-ir to stop after the IR and skip linking:");
    print("  miko --emit-ir <src.miko> <prefix>");
    print("");
    print("linking needs clang with the C runtime search paths. Those are read from");
    print("miko.toolchain (written at build time); without it plain clang is used.");
    print("");
    print("run from the repository root: modules resolve as compiler/<name>.miko");
}

fn version() {
    print("miko 0.2.0 (miko-implemented, LLVM IR backend)");
}

fn main(): i32 {
    if arg_count() >= 1 {
        let mode = arg_at(0);
        if mode == "--version" {
            version();
            return 0;
        }
        if mode == "--help" {
            usage();
            return 0;
        }
        if mode == "--self" {
            if arg_count() >= 2 {
                compile_self_to(arg_at(1));
                return 0;
            }
            compile_self();
            return 0;
        }
        if mode == "--emit-ir" {
            if arg_count() >= 3 {
                return compile_file(arg_at(1), arg_at(2), false);
            }
            if arg_count() == 2 {
                return compile_file(arg_at(0), arg_at(1), false);
            }
            eprint("miko: --emit-ir needs <src.miko> <prefix>");
            return 1;
        }
    }
    if arg_count() >= 3 {
        return compile_file(arg_at(1), arg_at(2), true);
    }
    if arg_count() == 2 {
        return compile_file(arg_at(0), arg_at(1), true);
    }
    compile_self();
    return 0;
}
