fn mix(n: i64): i64 {
    let acc: i64 = 1;
    let i: i64 = 1;

    while i <= n {
        acc = acc + (i * 3) % 97;
        if i % 2 == 0 {
            acc = acc - i / 3;
        } else {
            acc = acc + i / 5;
        }
        i = i + 1;
    }

    return acc;
}

fn main() {
    let total: i64 = 0;
    let round: i64 = 0;

    while round < 8 {
        total = total + mix(20000000);
        round = round + 1;
    }

    print(total);
}
