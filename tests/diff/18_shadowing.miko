fn pick(op: string): string {
    let v = "outer";
    if op == "/" {
        let v = "inner";
        return v;
    }
    return v;
}

fn counter(): i64 {
    let total = 1;
    let i = 0;
    while i < 3 {
        let total = 100;
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn main() {
    print(pick("+"));
    print(pick("/"));
    print(counter());
    let x = 100;
    let y = 7;
    print(x / y);
    if x > 50 {
        let x = 200;
        print(x / y);
        if true {
            let x = 300;
            print(x / y);
        }
        print(x / y);
    }
    print(x / y);
    let i = 0;
    while i < 3 {
        let x = i * 10;
        print(x + i);
        i = i + 1;
    }
    print(x);
}
