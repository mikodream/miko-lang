fn main() {
    let total = 0;
    let i = 0;
    while i < 5 {
        i = i + 1;
        if i == 3 {
            continue;
        }
        total = total + i;
    }
    print(total);
    let j = 0;
    for let k = 0; k < 10; k = k + 1 {
        if k == 4 {
            break;
        }
        j = j + k;
    }
    print(j);
}
